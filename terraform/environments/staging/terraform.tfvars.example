environment = "staging"
aws_region = "us-east-1"
cluster_name = "eks-platform-staging"
admin_principal_arn = "arn:aws:iam::123456789012:role/platform-admin" # replace
vpc_cidr = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
single_nat_gateway = false
endpoint_public_access = true
public_access_cidrs = ["203.0.113.10/32"]
enabled_cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
node_groups = {
  system = { instance_types = ["m6i.large"], capacity_type = "ON_DEMAND", desired_size = 2, min_size = 2, max_size = 4, disk_size = 50, labels = { workload = "system" }, taints = [] }
  application = { instance_types = ["m6i.large"], capacity_type = "ON_DEMAND", desired_size = 2, min_size = 1, max_size = 6, disk_size = 50, labels = { workload = "application" }, taints = [] }
}
