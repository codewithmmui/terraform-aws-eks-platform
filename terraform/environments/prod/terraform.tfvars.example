environment = "prod"
aws_region = "us-east-1"
cluster_name = "eks-platform-prod"
admin_principal_arn = "arn:aws:iam::123456789012:role/platform-admin" # replace
vpc_cidr = "10.30.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs = ["10.30.0.0/24", "10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.10.0/24", "10.30.11.0/24", "10.30.12.0/24"]
single_nat_gateway = false
endpoint_public_access = false
enabled_cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
log_retention_days = 90
node_groups = {
  system = { instance_types = ["m6i.large"], capacity_type = "ON_DEMAND", desired_size = 3, min_size = 3, max_size = 6, disk_size = 80, labels = { workload = "system" }, taints = [{ key = "CriticalAddonsOnly", value = "true", effect = "NO_SCHEDULE" }] }
  application = { instance_types = ["m6i.xlarge"], capacity_type = "ON_DEMAND", desired_size = 3, min_size = 3, max_size = 12, disk_size = 80, labels = { workload = "application" }, taints = [] }
  spot = { instance_types = ["m6i.large", "m6a.large", "m5.large"], capacity_type = "SPOT", desired_size = 0, min_size = 0, max_size = 10, disk_size = 50, labels = { workload = "batch", lifecycle = "spot" }, taints = [{ key = "lifecycle", value = "spot", effect = "NO_SCHEDULE" }] }
}
create_budget = true
monthly_budget = 1000
