environment          = "dev"
aws_region           = "us-east-1"
cluster_name         = "eks-platform-dev"
admin_principal_arn  = "arn:aws:iam::123456789012:role/platform-admin" # replace
vpc_cidr             = "10.10.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.10.0.0/24", "10.10.1.0/24"]
private_subnet_cidrs = ["10.10.10.0/24", "10.10.11.0/24"]
single_nat_gateway   = true
endpoint_public_access = true
public_access_cidrs    = ["203.0.113.10/32"] # replace with your trusted egress IP
node_groups = {
  system = { instance_types = ["t3.medium"], capacity_type = "ON_DEMAND", desired_size = 1, min_size = 1, max_size = 2, disk_size = 30, labels = { workload = "system" }, taints = [] }
  spot = { instance_types = ["t3.medium", "t3a.medium"], capacity_type = "SPOT", desired_size = 1, min_size = 0, max_size = 3, disk_size = 30, labels = { workload = "application", lifecycle = "spot" }, taints = [] }
}
create_budget      = true
monthly_budget     = 150
# budget_alert_email = "owner@example.com"
